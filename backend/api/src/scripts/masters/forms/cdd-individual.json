{
  "form": {
    "name": "CDD: Individual",
    "description": "Customer due diligence form for an individual customer, with associated parties and an officer risk assessment.",
    "settings": {
      "intro": "Please complete this form. Fields marked * are required.",
      "consentText": "I declare that the information provided in this form is accurate and truthful. I understand that if I am found to have knowingly made false statements or intentionally omitted any significant details, I may face prosecution and legal penalties under applicable law.",
      "publicEnabled": true,
      "requireApprovedToExport": false
    },
    "schema": {
      "sections": [
        {
          "id": "customer",
          "title": "Customer information",
          "fields": [
            {
              "id": "f1",
              "key": "full_name",
              "type": "text",
              "label": "Full name",
              "required": true
            },
            {
              "id": "f2",
              "key": "gender",
              "type": "select",
              "label": "Gender",
              "options": [
                {
                  "value": "male",
                  "label": "Male"
                },
                {
                  "value": "female",
                  "label": "Female"
                },
                {
                  "value": "other",
                  "label": "Other"
                }
              ]
            },
            {
              "id": "f3",
              "key": "id_no",
              "type": "text",
              "label": "Identification no.",
              "required": true
            },
            {
              "id": "f4",
              "key": "id_expiry",
              "type": "date",
              "label": "Expiry date of ID"
            },
            {
              "id": "f5",
              "key": "nationality",
              "type": "country",
              "label": "Nationality"
            },
            {
              "id": "f6",
              "key": "dob",
              "type": "date",
              "label": "Date of birth"
            },
            {
              "id": "f7",
              "key": "address",
              "type": "longtext",
              "label": "Address"
            },
            {
              "id": "f8",
              "key": "email",
              "type": "email",
              "label": "Email"
            },
            {
              "id": "f9",
              "key": "contact_no",
              "type": "phone",
              "label": "Contact number"
            }
          ]
        },
        {
          "id": "case",
          "title": "Case information",
          "fields": [
            {
              "id": "f10",
              "key": "services",
              "type": "multiselect",
              "label": "Nature of services provided",
              "options": [
                {
                  "value": "o1",
                  "label": "Buying of Precious Stones."
                },
                {
                  "value": "o2",
                  "label": "Buying of Precious Metals."
                },
                {
                  "value": "o3",
                  "label": "Selling of Precious Stones."
                },
                {
                  "value": "o4",
                  "label": "Selling of Precious Metals."
                },
                {
                  "value": "o5",
                  "label": "Buying of Property."
                },
                {
                  "value": "o6",
                  "label": "Selling of Property."
                },
                {
                  "value": "o7",
                  "label": "Renting of Property."
                },
                {
                  "value": "o8",
                  "label": "Financing of Property."
                }
              ]
            },
            {
              "id": "f11",
              "key": "remarks",
              "type": "longtext",
              "label": "Remarks"
            }
          ]
        },
        {
          "id": "parties",
          "title": "Associated parties",
          "fields": [
            {
              "id": "f19",
              "key": "parties_company",
              "type": "group",
              "label": "Associated companies",
              "help": "Entities connected to this customer, for example corporate shareholders.",
              "group": {
                "max": 50,
                "fields": [
                  {
                    "id": "f12",
                    "key": "c_name",
                    "type": "text",
                    "label": "Entity name",
                    "required": true
                  },
                  {
                    "id": "f13",
                    "key": "c_uen",
                    "type": "text",
                    "label": "Unique entity no."
                  },
                  {
                    "id": "f14",
                    "key": "c_country",
                    "type": "country",
                    "label": "Country of incorporation"
                  },
                  {
                    "id": "f15",
                    "key": "c_inc_date",
                    "type": "date",
                    "label": "Date of incorporation"
                  },
                  {
                    "id": "f16",
                    "key": "c_address",
                    "type": "longtext",
                    "label": "Registered address"
                  },
                  {
                    "id": "f17",
                    "key": "c_registrable_controller",
                    "type": "yesno",
                    "label": "Is the entity a registrable controller of the company?"
                  },
                  {
                    "id": "f18",
                    "key": "c_remarks",
                    "type": "text",
                    "label": "Remarks"
                  }
                ]
              }
            },
            {
              "id": "f30",
              "key": "parties_individual",
              "type": "group",
              "label": "Associated individuals",
              "help": "Directors, shareholders, beneficial owners or signatories connected to this customer.",
              "group": {
                "max": 50,
                "fields": [
                  {
                    "id": "f20",
                    "key": "p_name",
                    "type": "text",
                    "label": "Full name",
                    "required": true
                  },
                  {
                    "id": "f21",
                    "key": "p_id_no",
                    "type": "text",
                    "label": "Identification no."
                  },
                  {
                    "id": "f22",
                    "key": "p_nationality",
                    "type": "country",
                    "label": "Nationality"
                  },
                  {
                    "id": "f23",
                    "key": "p_role",
                    "type": "select",
                    "label": "Role",
                    "options": [
                      {
                        "value": "director",
                        "label": "Director"
                      },
                      {
                        "value": "shareholder",
                        "label": "Shareholder"
                      },
                      {
                        "value": "beneficial_owner",
                        "label": "Beneficial owner"
                      },
                      {
                        "value": "authorised_signatory",
                        "label": "Authorised signatory"
                      },
                      {
                        "value": "other",
                        "label": "Other"
                      }
                    ]
                  },
                  {
                    "id": "f24",
                    "key": "p_share_pct",
                    "type": "number",
                    "label": "Shareholding (%)",
                    "min": 0,
                    "max": 100
                  },
                  {
                    "id": "f25",
                    "key": "p_custom_behalf",
                    "type": "yesno",
                    "label": "Is the individual acting on behalf of the customer?"
                  },
                  {
                    "id": "f26",
                    "key": "p_more_than25_percent",
                    "type": "yesno",
                    "label": "Does the individual control more than 25% share of the company?"
                  },
                  {
                    "id": "f27",
                    "key": "p_registrable_controller",
                    "type": "yesno",
                    "label": "Is the individual a registrable controller of the company?"
                  },
                  {
                    "id": "f28",
                    "key": "p_pep",
                    "type": "yesno",
                    "label": "Is the individual an Politically Exposed Person (PEP), or an immediate family member or a close associate of a PEP?"
                  },
                  {
                    "id": "f29",
                    "key": "p_fund_info",
                    "type": "yesno",
                    "label": "Are information on Source of Wealth or Source of Funds required?"
                  }
                ]
              }
            }
          ]
        },
        {
          "id": "declaration",
          "title": "Declaration",
          "fields": [
            {
              "id": "f31",
              "key": "declaration_signature",
              "type": "signature",
              "label": "Signature",
              "required": true,
              "help": "Type your full name to sign."
            }
          ]
        },
        {
          "id": "risk",
          "title": "Risk assessment (officer use)",
          "fields": [
            {
              "id": "f32",
              "key": "risk_customer",
              "type": "checklist",
              "label": "Customer risk assessment",
              "required": true,
              "internal": true,
              "options": [
                {
                  "value": "q1",
                  "label": "Is there any match on Ministry of Home Affairs (“MHA”)’s website on the Inter-Ministry Committee on Terrorist Designation (“IMC-TD”) on terrorist designation (persons and entities designated as terrorists)?"
                },
                {
                  "value": "q2",
                  "label": "Is there any match on Monetary Authority of Singapore (“MAS”)’s website on targeted financial sanctions under the United Nations Regulations (“UN Regulations”) for the lists of designated individuals and entities?"
                },
                {
                  "value": "q3",
                  "label": "Is the customer a PEP?"
                },
                {
                  "value": "q4",
                  "label": "Is the customer's country on FATF public list on high-risk and other monitored jurisdictions?"
                },
                {
                  "value": "q5",
                  "label": "Does the customer fit the profile of a higher-risk customer based on their own risk assessment conducted by regulated dealer?"
                }
              ]
            },
            {
              "id": "f33",
              "key": "risk_rating",
              "type": "select",
              "label": "Risk assessment rating",
              "internal": true,
              "options": [
                {
                  "value": "low",
                  "label": "Low"
                },
                {
                  "value": "medium",
                  "label": "Medium"
                },
                {
                  "value": "high",
                  "label": "High"
                }
              ]
            },
            {
              "id": "f34",
              "key": "risk_comment",
              "type": "longtext",
              "label": "Risk assessment comment",
              "internal": true
            },
            {
              "id": "f35",
              "key": "recommendation",
              "type": "select",
              "label": "Acceptance of customer",
              "internal": true,
              "options": [
                {
                  "value": "yes",
                  "label": "Yes"
                },
                {
                  "value": "no",
                  "label": "No"
                }
              ]
            },
            {
              "id": "f36",
              "key": "recommending_officer",
              "type": "text",
              "label": "Recommending officer",
              "internal": true
            },
            {
              "id": "f37",
              "key": "recommendation_comment",
              "type": "longtext",
              "label": "Recommendation comment",
              "internal": true
            },
            {
              "id": "f38",
              "key": "approval",
              "type": "select",
              "label": "Approval for acceptance",
              "internal": true,
              "options": [
                {
                  "value": "yes",
                  "label": "Yes"
                },
                {
                  "value": "no",
                  "label": "No"
                }
              ]
            },
            {
              "id": "f39",
              "key": "approving_officer",
              "type": "text",
              "label": "Approving officer",
              "internal": true
            },
            {
              "id": "f40",
              "key": "approval_comment",
              "type": "longtext",
              "label": "Approval comment",
              "internal": true
            },
            {
              "id": "f41",
              "key": "screening_notes",
              "type": "longtext",
              "label": "Screening results and notes",
              "internal": true,
              "help": "Name screening outcome (sanctions, adverse media) for the customer and associated parties."
            }
          ]
        }
      ]
    }
  },
