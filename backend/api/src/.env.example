# Copy to .env.local / .env.stage / .env.prod (git-ignored) and fill in. Secrets never go in
# these files: see .env.example.secret. Names must match backend/infra/_env.sh.
# Server Configuration
NODE_ENV=development
STAGE_ENV=local
PORT=3006
# AWS Configuration (profile: paprcraft-dev-loy)
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=stage.storage.paprcraft        # prod: prod.storage.paprcraft  (infra/28-attachments.sh)
AWS_S3_BASE_URL=
# DynamoDB Configuration (infra/01-create-dynamodb-tables.sh)
DYNAMODB_TABLE=stage-paprcraft-dynamo-db     # prod: prod-paprcraft-dynamo-db
DYNAMODB_TABLE_AUDIT_TRAIL=stage-paprcraft-dynamo-db-audit-trail
SES_FROM_EMAIL=no-reply@stg.paprcraft.com
# Default Organization
DEFAULT_ORGANIZATION_ID=paprcraft
# CORS Configuration
ALLOWED_ORIGIN=https://localhost:6100,https://localhost:6200,https://localhost:6300
# Google OAuth: GOOGLE_CLIENT_SECRET lives in .env.secret locally / as a Lambda env var when deployed.
GOOGLE_CLIENT_ID=
# Document template renderer (the docx Lambda; infra/29-docx-template.sh). Set on the deployed API by
# infra/10-api-lambda-function.sh. Locally leave empty (exports are refused) or point at a deployed one.
DOCX_LAMBDA_NAME=
